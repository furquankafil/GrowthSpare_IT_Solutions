# ==============================================================================
# GrowthSpare IT Solutions - Environment Configuration Example
# Copy this file to '.env' and populate it with your private keys and credentials.
# ==============================================================================

# Django Core Security Settings
SECRET_KEY=django-insecure-prod-ready-secret-key-change-this-to-a-secure-50-character-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,growthspareitsolutions.com,*.growthspareitsolutions.com

# Django Settings Select (config.settings.development or config.settings.production)
DJANGO_SETTINGS_MODULE=config.settings.development

# Database Settings (Defaults to SQLite in local/development if DATABASE_URL is unset)
# For production PostgreSQL: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://growthspare_user:securepassword123@127.0.0.1:5432/growthspare_db

# PostgreSQL Backup Parameters (For Docker-compose)
POSTGRES_DB=growthspare_db
POSTGRES_USER=growthspare_user
POSTGRES_PASSWORD=securepassword123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Production HTTPS and Security Enhancements (Set to True in Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# CORS and Trust Configurations
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://growthspareitsolutions.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://growthspareitsolutions.com

# Email / Verification System Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=growthspareitsolution@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-email-password-here
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GrowthSpare IT Solutions <growthspareitsolution@gmail.com>

# Third-Party API System Keys
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-Y

# Corporate Office Location (used on the Contact page — both the displayed
# address and the embedded Google Maps iframe read from these, so moving
# offices only requires updating .env, not templates or code)
OFFICIAL_LOCATION_ADDRESS=D-50, Shaheen Bagh, Okhla, New Delhi – 110025, India
GOOGLE_MAPS_EMBED_QUERY=D-50, Shaheen Bagh, Okhla, New Delhi 110025

# Cache & Redis Settings (Optional in Development, recommended for Production caching)
REDIS_URL=redis://127.0.0.1:6379/1